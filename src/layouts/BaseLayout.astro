---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import { getAlternateLinks } from "../lib/hreflang";
import { buildOrganizationSchema } from "../lib/schema";
import "../assets/css/style.css";
import "../styles/global.css";

interface Props {
  lang: "es" | "eu";
  title: string;
  /** Meta description específica de la página; si no se pasa, usa el texto genérico del sitio. */
  description?: string;
  /** Ruta absoluta o relativa a una imagen para og:image/twitter:image. Por defecto, el logo del sitio. */
  image?: string;
  /** Marca la página como no indexable (noindex,nofollow). */
  noindex?: boolean;
  /** Uno o varios objetos JSON-LD a incluir en el <head> de esta página. */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const DEFAULT_DESCRIPTION =
  "Formación bonificada, diseño web, creación de aplicaciones, consultoría informática y automatización de procesos para PYMES de Euskadi. Gestión sin burocracia y bilingüismo integral.";

const {
  lang,
  title,
  description = DEFAULT_DESCRIPTION,
  image = "/images/BideDigitala.png",
  noindex = false,
  jsonLd,
} = Astro.props;

const hasSecondaryNav = Astro.slots.has("secondary-nav");

// Sin barra final, para comparaciones de ruta robustas frente a
// trailingSlash: 'always' (ver astro.config.mjs) — Astro.url.pathname
// siempre la lleva, pero no dependemos de eso.
const pathNoSlash = Astro.url.pathname.replace(/\/$/, "");

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);
// La Organización se incluye siempre; el resto del JSON-LD lo aporta cada página.
const jsonLdItems = [
  buildOrganizationSchema(),
  ...(jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : []),
];

// hreflang: misma fuente de verdad que el selector de idioma visual (CambioIdioma).
const alternates = await getAlternateLinks(Astro.url.pathname, lang);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}

    <!-- Hreflang: solo se declara el idioma alterno cuando hay una traducción real -->
    {alternates.es.matched && (
      <link rel="alternate" hreflang="es" href={new URL(alternates.es.href, Astro.site)} />
    )}
    {alternates.eu.matched && (
      <link rel="alternate" hreflang="eu" href={new URL(alternates.eu.href, Astro.site)} />
    )}
    <link rel="alternate" hreflang="x-default" href={new URL(alternates.eu.href, Astro.site)} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={lang === "es" ? "es_ES" : "eu_ES"} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

    <!-- IAFormacionES/EU.astro (/ia-centros-educativos) usan imágenes de Unsplash
         hotlinkeadas, incluida la de fondo del hero (probable elemento LCP de
         esa página). Preconnect en todas las páginas: es una única entrada de
         DNS/TLS de coste fijo, no un recurso pesado. -->
    <link rel="preconnect" href="https://images.unsplash.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <title>{title}</title>

    {jsonLdItems.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body>
    <!-- Cabecera común con navegación secundaria opcional -->
    <Header lang={lang} altLinks={alternates}>
      {hasSecondaryNav && <slot name="secondary-nav" slot="secondary-nav" />}
    </Header>

    <!-- Contenido dinámico de cada página -->
    <main>
      <slot />
    </main>

    <!-- Pie de página común -->
    <Footer lang={lang} />

    <!-- Banner de consentimiento de cookies (analítica propia, sin terceros) -->
    <CookieBanner lang={lang} />

    <!-- Tu JavaScript de interacción -->
    <!-- <script src="/assets/js/script.js?v=2026-08-15-2" defer></script> -->
    {pathNoSlash !== `/${lang}/ia-centros-educativos` && (
      <script src="/assets/js/script.js?v=2026-08-15-2" defer></script>
    )}
    <script src="/assets/js/visitas.js?v=2026-08-15-2" defer></script>

  </body>
</html>
