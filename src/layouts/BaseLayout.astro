---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CookieBanner from "../components/CookieBanner.astro";
import "../assets/css/style.css";
import "../styles/global.css";
const { lang, title } = Astro.props;
const hasSecondaryNav = Astro.slots.has("secondary-nav");
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.ico" type="image/x-icon" />
    <meta
      name="description"
      content="Formación bonificada, diseño web, creación de aplicaciones, consultoría informática y automatización de procesos para PYMES de Euskadi. Gestión sin burocracia y bilingüismo integral."
    />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- Font Awesome -->
    <link
      rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css"
    />
    <title>{title}</title>
  </head>
  <body>
    <!-- Cabecera común con navegación secundaria opcional -->
    <Header lang={lang}>
      {hasSecondaryNav && <slot name="secondary-nav" slot="secondary-nav" />}
    </Header>

    <!-- Contenido dinámico de cada página -->
    <main>
      <slot />
    </main>

    <!-- Pie de página común -->
    <Footer lang={lang} />

    <!-- Banner de consentimiento de cookies (analítica propia, sin terceros) -->
    <CookieBanner lang={lang} />

    <!-- Tu JavaScript de interacción -->
    <!-- <script src="/assets/js/script.js?v=2025-09-03-1" defer></script> -->
    {Astro.url.pathname !== `/${lang}/ia-centros-educativos` && (
  <script src="/assets/js/script.js?v=2025-09-03-1" defer></script>
)}
    <script src="/assets/js/analytics.js?v=2026-08-14-1" defer></script>

  </body>
</html>
