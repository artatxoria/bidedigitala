---
// src/components/CookieBanner.astro
// Banner de consentimiento para la cookie propia de analítica (bd_vid/bd_sid).
// Oculto por defecto (evita parpadeo antes de que cargue el JS); lo muestra
// public/assets/js/analytics.js solo si no hay una decisión previa guardada.
import { t, tPath } from "../lib/translations";
const { lang } = Astro.props;
---

<div id="cookie-banner" class="cookie-banner" hidden>
  <p>
    {t(lang, "cookies.message")}
    {" "}
    <a href={tPath("/privacidad", lang)}>{t(lang, "cookies.policyLink")}</a>
  </p>
  <div class="cookie-banner-actions">
    <button id="cookie-reject" type="button" class="cookie-btn cookie-btn-secondary">
      {t(lang, "cookies.reject")}
    </button>
    <button id="cookie-accept" type="button" class="cookie-btn cookie-btn-primary">
      {t(lang, "cookies.accept")}
    </button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 9999;
    max-width: 560px;
    margin: 0 auto;
    background: #111827;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .cookie-banner p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }
  .cookie-banner a {
    color: #a78bfa;
    text-decoration: underline;
  }
  .cookie-banner-actions {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
  }
  .cookie-btn {
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
  }
  .cookie-btn-primary {
    background: #8b5cf6;
    border-color: #8b5cf6;
    color: white;
  }
  .cookie-btn-secondary {
    background: transparent;
    color: white;
  }
</style>
