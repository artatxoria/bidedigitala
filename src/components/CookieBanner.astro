---
// src/components/CookieBanner.astro
// Aviso de cookies para la cookie propia de analítica (bd_vid/bd_sid).
// Oculto por defecto (evita parpadeo antes de que cargue el JS); lo muestra
// public/assets/js/visitas.js solo si no hay una decisión previa guardada.
//
// Los botones son un <form method="POST"> real contra /api/consent: la
// decisión se guarda con una navegación normal del navegador, sin depender
// de que se ejecute ningún listener de clic. Así el aviso funciona incluso
// si algún bloqueador de anuncios/antivirus interfiere con el JavaScript de
// la página — solo mostrar/ocultar el aviso según la cookie necesita JS,
// nunca la acción de aceptar/rechazar.
//
// Ids/clases con prefijo "bd-" a propósito: algunos bloqueadores (p.ej. el
// Shield de "avisos de cookies" de Brave, activado por defecto) ocultan o
// inutilizan cualquier elemento con nombres genéricos tipo "cookie-banner"
// / "cookie-consent" / "cookie-accept", que es justo como se llama la
// mayoría de estos avisos en el resto de la web.
import { t, tPath } from "../lib/translations";
const { lang } = Astro.props;
const redirectTo = Astro.url.pathname;
---

<div id="bd-cookie-notice" class="bd-cookie-notice" hidden>
  <p>
    {t(lang, "cookies.message")}
    {" "}
    <a href={tPath("/privacidad", lang)}>{t(lang, "cookies.policyLink")}</a>
  </p>
  <form method="POST" action="/api/consent" class="bd-cookie-notice-acciones">
    <input type="hidden" name="redirect" value={redirectTo} />
    <button type="submit" name="decision" value="rejected" class="bd-cookie-btn bd-cookie-btn-secundario">
      {t(lang, "cookies.reject")}
    </button>
    <button type="submit" name="decision" value="accepted" class="bd-cookie-btn bd-cookie-btn-primario">
      {t(lang, "cookies.accept")}
    </button>
  </form>
</div>

<style>
  .bd-cookie-notice {
    position: fixed;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    z-index: 9999;
    max-width: 560px;
    margin: 0 auto;
    background: #111827;
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 1.25rem 1.5rem;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.35);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .bd-cookie-notice p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.9);
  }
  .bd-cookie-notice a {
    color: #a78bfa;
    text-decoration: underline;
  }
  .bd-cookie-notice-acciones {
    display: flex;
    gap: 0.75rem;
    justify-content: flex-end;
    margin: 0;
  }
  .bd-cookie-btn {
    padding: 0.5rem 1.1rem;
    border-radius: 8px;
    border: 1px solid rgba(255, 255, 255, 0.3);
    font-size: 0.85rem;
    cursor: pointer;
    font-family: inherit;
  }
  .bd-cookie-btn-primario {
    background: #8b5cf6;
    border-color: #8b5cf6;
    color: white;
  }
  .bd-cookie-btn-secundario {
    background: transparent;
    color: white;
  }
</style>
