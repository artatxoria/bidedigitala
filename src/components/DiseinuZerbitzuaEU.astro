---
import '../styles/diseinu-zerbitzua.css';
import BaseLayout from '../layouts/BaseLayout.astro';
import NavegacionSecundariaDiseinu from './NavegacionSecundariaDiseinu.astro';
import SectionDivider from './SectionDivider.astro';
import { tPath } from '../lib/translations';
import { organizationData } from '../lib/schema';

// 'provider' reutiliza organizationData (src/lib/schema.ts) en vez de una
// copia propia — evita que este Service quede desincronizado si cambian
// los datos de la Organización (el mismo tipo de deuda que causó el bug
// original de este archivo, ver Ronda 1).
const schema = { "@context": "https://schema.org", "@type": "Service", "name": "Web diseinua eta GEO optimizazioa", "description": "Ziurgabetasunaren amaiera: zure webgunea negozioa sortzen duen aktibo bihurtu. GEO eta AI aplikazioa ETE industrialetan.", "url": "https://www.bidedigitala.eus/eu/diseinu-zerbitzua/", "inLanguage": "eu", "areaServed": ["Euskal Herria", "España"], "serviceType": ["GEO (Generative Engine Optimization)", "Ingeniería Digital", "Optimización de Conversiones B2B", "Análisis de Datos", "Desarrollo Web orientado a KPI"], "audience": { "@type": "BusinessAudience", "audienceType": "PYMES industriales · Industria 4.0 · B2B" }, "provider": organizationData };
---

<BaseLayout lang="eu" title="BideDigitala · Berrikuntza zure bidean" description="Ziurgabetasunaren amaiera: zure webgunea negozioa sortzen duen aktibo bihurtu. GEO eta Adimen Artifizialean oinarritutako ingeniaritza digitala ETE industrialentzat." jsonLd={schema}>
  <NavegacionSecundariaDiseinu lang="eu" slot="secondary-nav" />

  <div class="container">
    <!-- HERO --> <section
class="hero" id="hasiera"> <div class="hero-grid"> <div class="hero-copy"> <div
class="hero-eyebrow"> <span class="hero-eyebrow-dot"></span> <span
>Ziurgabetasun teknologikoaren aurkako estrategia B2B</span > </div> <h1>
Ziurgabetasunaren amaiera: zure webgunea negozioa sortzen duen aktibo bihurtu.
azelerazioarekin. </p> <p class="hero-note"> Webgune pasibo bat izatetik KPI
industrialetan oinarritutako aktibo digital errentagarri batera igarotzen gara.
</p> <div class="hero-ctas"> <a href="#diagnostikoa" class="btn-primary"> <span
>Hitz egin dezagun ingeniaritza digitalaz</span > <span
aria-hidden="true">↗</span> </a> <a href="#prozesua" class="btn-secondary">
<span>Ikusi nola lan egiten dugun</span> </a> </div> <div class="hero-meta"> <div
class="hero-meta-pill"> GEO · IA · B2B Performance </div> <span >Ziurgabetasun
teknologikoa &amp; emaitzarik gabeko inbertsioak → aktibo digital
errentagarriak.</span > </div> </div> <div class="hero-visual"
aria-hidden="true"> <div class="hero-background" style="background-image:
url('https://images.unsplash.com/photo-1518770660439-4636190af475?q=80&w=2070&auto=format&fit=crop');"
> </div> <div class="hero-panel"> <h2>Negozio-metrikak, ez vanity datuak</h2>
<div class="hero-panel-row"> <span class="hero-panel-badge" >Lead Acquisition
Cost</span > <span class="hero-panel-badge" >Aukeraren Balioa</span > <span
class="hero-panel-badge" >Inbertsioaren Itzulera (ROI)</span > </div> <p
class="hero-panel-metric"> Zure txostenetan ez duzu klik edo inpresio hutsik
ikusiko: soilik diru-sarreretan eragina duten datu gakoak. </p> </div> </div>
</div> </section> <!-- BALIO PROPOSAMENA / PILAREAK --> <section
id="balio-proposamena"> <div class="section-heading"> <span
class="section-eyebrow" >Zure bezeroen mina · Gure balioa</span > <h2
class="section-title"> Ziurgabetasun teknologikotik kontrol eta
errentagarritasunera. </h2> <p class="section-description"> Ziurgabetasuna,
hizkera tekniko iluna eta txosten ulertezinak ordezkatzen ditugu gardentasuna,
pedagogia eta errentagarritasunarekin. </p> </div> <div class="pillars-grid">
<article class="pillar-card"> <div class="pillar-icon">📚</div> <h3
class="pillar-title"> Zutabea 1: Pedagogia eta Kontrola </h3> <p
class="pillar-body"> Ulertu zergatik egiten dugun egiten duguna. Zure
estrategiaren giltza ematen dizugu etengabeko prestakuntzaren eta metrika zein
prozesuen gardentasun osoaren bidez. </p> </article> <article
class="pillar-card"> <div class="pillar-icon">🎯</div> <h3 class="pillar-title">
Zutabea 2: Hiper-fokatutako Espezializazioa </h3> <p class="pillar-body"> Ez
dugu baliabiderik xahutzen orokortasunetan. Gure taldeak B2B Performance
pentsamoldearekin eta errentagarritasunean (ROI) foku obsesiboarekin lan egiten
du. </p> </article> <article class="pillar-card"> <div
class="pillar-icon">🤝</div> <h3 class="pillar-title"> Zutabea 3: Epe Luzeko
Bazkidea </h3> <p class="pillar-body"> Ahaztu ezazu abandonu digitala. Kanpoko
marketin-sail bat gara, etengabeko hobekuntza bermatzen duena eta zu mantentzeko
iraupen-kontratuen menpe ez dagoena. </p> </article> </div> <figure
class="block" style="margin-top: 1.8rem;"> <img
src="https://images.unsplash.com/photo-1553877522-43269d4ea984?q=80&w=1920&auto=format&fit=crop"
alt="Atzeko plano teknologiko abstraktu more-urdina" loading="lazy" /> <figcaption
class="block-body"> BideDigitalaren identitate bisuala indartzen duen abstrakzio
teknologikoa: tonu garbiak, zehaztasuna eta industria-ingurunearekin koherentzia
estetikoa. </figcaption> </figure> </section> <SectionDivider /> <!-- PROZESUA --> <section
id="prozesua"> <div class="section-heading"> <span class="section-eyebrow"
>Metodologia · Gardentasuna</span > <h2 class="section-title"> Gure Metodologia:
Ingeniaritza Digitala emaitza aurreikusteko modukoetarako. </h2> <p
class="section-description"> Ez dugu web bat diseinatzen “gustu pertsonalaren”
arabera. Diagnostiko zehatz bat, roadmap modular garden bat eta inplementazio
jarraitua diseinatzen ditugu, zure KPI industrialekin lotuta. </p> </div> <div
class="process-grid"> <article class="process-step"> <span
class="process-number">1/3</span> <h3 class="process-label"> 1. Urratsa:
Diagnostiko Estrategikoa </h3> <p class="process-body"> Zure negozioaren eta
ingurunearen azterketa zehatza, Buyer Persona industriala eta konpondu beharreko
min-puntuak zehaztuz. </p> </article> <article class="process-step"> <span
class="process-number">2/3</span> <h3 class="process-label"> 2. Urratsa: Roadmap
Modularra </h3> <p class="process-body"> Ekintza-plan malgu eta garden baten
diseinua (GDD), negozio-KPIetan eta bihurketan soilik zentratua. </p> </article>
<article class="process-step"> <span class="process-number">3/3</span> <h3
class="process-label"> 3. Urratsa: Etengabeko Inplementazioa </h3> <p
class="process-body"> Web-garapen optimizatua eta kanal anitzeko kanpainen
aktibazioa, inbertsio bakoitzak inpaktu azkar eta neurgarria izan dezan
bermatuz. </p> </article> </div> </section> <SectionDivider /> <!-- ARRISKUA / BERMEA --> <section
id="arriskua"> <div class="section-heading"> <span
class="section-eyebrow">Arriskua · Bermea</span> <h2 class="section-title">
Arrisku bakarra berdin jarraitzea da. </h2> <p class="section-description"> Zure
inbertsio digitalak ez du lotura izan behar “probatu eta ikusi” logikarekin.
Lerrokatze absolutua eskaintzen dugu: zuk irabazten baduzu bakarrik irabazten
dugu guk. </p> </div> <div class="block"> <h3 class="block-title"> Zure
helburuekin erabateko lerrokatzea </h3> <p class="block-body"> Gure
negozio-ereduak zure helburuekin erabateko lerrokatzea eskatzen digu. Zuk
irabazten baduzu bakarrik irabazten dugu guk. Horregatik, gure txostenetan ez
dituzu metrika hutsalik aurkituko (klikak edo inpresioak, adibidez), baizik eta
finantza-datu gakoak: Lead Acquisition Cost, Aukeraren Balioa eta Inbertsioaren
Itzulera (ROI). Loturarik gabe lan egiten dugu: zuk kontrol eta malgutasun osoa
mantentzen duzu. </p> </div> </section> <SectionDivider /> <!-- GEO / IA --> <section id="geo-ia">
<div class="section-heading"> <span class="section-eyebrow" >GEO · IA ·
Berrikuntza</span > <h2 class="section-title"> GEO eta IA: etorkizunari aurre
egiteko moduko posizionamendua. </h2> <p class="section-description"> Bilaketa
tradizionalen SEOtik harago goaz. Zure marka ahots bidezko bilaketetan eta motor
sortzaileetan kokatzen dugu, bezero industrialak irtenbide baten bila
dabiltzanean. </p> </div> <div class="block-layout"> <div class="block"> <div
class="block-tag-row"> <span class="block-tag" >Generative Engine Optimization
(GEO)</span > <span class="block-tag">Data Science</span> <span
class="block-tag" >ChatGPT · Gemini · Ahots-bilaketa</span > </div> <h3
class="block-title"> Zure marka, galderen erdigunean </h3> <p
class="block-body"> Zure estrategia prest al dago ahots bidezko edo Chatbot
bidezko bilaketetarako? GEO (Generative Engine Optimization) eta Data Science
aplikatzen ditugu, zure enpresa Google-n ez ezik, baita ChatGPT eta Gemini
bezalako motor sortzaileetan ere ikusgai egon dadin. Utzi iraganaren atzetik
ibiltzeari; bermatzen dugu zure marka bezeroek irtenbide industrial baten bila
aktiboki dabiltzanean jotzen duten kontsulta-iturri izatea. </p> </div> <aside
class="block"> <h3 class="block-title"> BideDigitalaren posizionamendua </h3> <p
class="block-body"> Ez gara agentzia orokor bat. ETE industrialetan eta B2B
fluxu konplexuetan espezializatutako bazkide teknologiko eta pedagogiko bat
gara: zure ekipoko kide baten gertutasuna, ingeniaritza-talde baten
zehaztasunarekin. </p> </aside> </div> </section> <!-- CTA NAGUSIA --> <section
id="diagnostikoa"> <div class="cta-final"> <div> <h2>Hitz egin dezagun
ingeniaritza digitalaz.</h2> <p> Eskatu orain zure doako Diagnostiko
Estrategikoa eta ezagutu zure negozioaren benetako ahalmena. Ez dugu aurkezpen
orokorrik egiten: zure KPI industrialetara egokitutako plano zehatza entregatzen
dugu. </p> </div> <div class="cta-final-actions"> <a
href={`${tPath('/', 'eu')}#contacto`}
class="btn-primary" > <span>Eskatu doako diagnostikoa</span> <span
aria-hidden="true">✉️</span> </a> <a href="#hasiera" class="btn-secondary
cta-outline" > <span>Itzuli goialdera</span> </a> </div> </div> </section>
  </div>
</BaseLayout>
