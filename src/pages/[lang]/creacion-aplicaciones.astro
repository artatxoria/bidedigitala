---
// src/pages/[lang]/creacion-aplicaciones.astro
import BaseLayout from "../../layouts/BaseLayout.astro";
import { t, tPath } from "../../lib/translations";
import SectionDivider from "../../components/SectionDivider.astro";

export async function getStaticPaths() {
  return [{ params: { lang: "es" } }, { params: { lang: "eu" } }];
}
export const prerender = true;

const supported = ["es", "eu"] as const;
type Lang = (typeof supported)[number];

const langParam = Astro.params.lang;
const lang: Lang = supported.includes(langParam as any)
  ? (langParam as Lang)
  : "es";

// Traducciones embebidas directamente en el archivo (mismo patrón que catalogo.astro)
const translations: Record<
  Lang,
  {
    title: string;
    subtitulo: string;
    intro: string;
    ctaHero: string;
    queTitle: string;
    queSubtitle: string;
    que: { icon: string; title: string; desc: string }[];
    procesoTitle: string;
    proceso: { titulo: string; contenido: string }[];
    ctaTitle: string;
    ctaBody: string;
    ctaButton: string;
  }
> = {
  es: {
    title: "Creación de Aplicaciones",
    subtitulo: "Software y aplicaciones a medida para tu negocio",
    intro:
      "Diseñamos y desarrollamos aplicaciones web, de escritorio y herramientas internas que se ajustan a cómo trabaja realmente tu empresa, no al revés. De la idea al software en producción.",
    ctaHero: "Cuéntanos tu proyecto",
    queTitle: "Qué desarrollamos",
    queSubtitle: "Elegimos la tecnología según tu necesidad, no al contrario.",
    que: [
      {
        icon: "fa-desktop",
        title: "Herramientas internas y de escritorio",
        desc: "Aplicaciones a medida (por ejemplo con Python) para digitalizar tareas manuales o repetitivas de tu equipo.",
      },
      {
        icon: "fa-globe",
        title: "Aplicaciones y plataformas web",
        desc: "Desarrollo con PHP/Laravel, Node.js o Django: paneles de gestión, portales de clientes, plataformas a medida.",
      },
      {
        icon: "fa-plug",
        title: "Integraciones y automatización",
        desc: "Conectamos tu nuevo software con tus herramientas actuales (CRM, ERP, hojas de cálculo, n8n) para que la información fluya sola.",
      },
      {
        icon: "fa-wrench",
        title: "Mantenimiento y evolución",
        desc: "No desaparecemos tras la entrega: damos soporte y seguimos desarrollando funcionalidades a medida que tu negocio crece.",
      },
    ],
    procesoTitle: "Cómo trabajamos",
    proceso: [
      {
        titulo: "Diagnóstico y alcance",
        contenido:
          "Analizamos el proceso o problema real que quieres resolver y definimos un alcance claro, sin sobredimensionar el proyecto.",
      },
      {
        titulo: "Prototipo y validación",
        contenido:
          "Antes de programar a fondo, validamos contigo un prototipo funcional para asegurarnos de que vamos en la dirección correcta.",
      },
      {
        titulo: "Desarrollo iterativo",
        contenido:
          "Construimos la aplicación en entregas incrementales, con comunicación constante y sin sorpresas de última hora.",
      },
      {
        titulo: "Puesta en marcha y soporte",
        contenido:
          "Desplegamos la aplicación, formamos a tu equipo en su uso y quedamos disponibles para el mantenimiento posterior.",
      },
    ],
    ctaTitle: "¿Tienes una idea o un proceso que digitalizar?",
    ctaBody:
      "Cuéntanos qué necesitas y te decimos, sin compromiso, cómo lo abordaríamos y qué tecnología tiene sentido para tu caso.",
    ctaButton: "Solicitar información",
  },
  eu: {
    title: "Aplikazioen Sorkuntza",
    subtitulo: "Zure negoziorako neurrizko softwarea eta aplikazioak",
    intro:
      "Zure enpresak benetan lan egiten duen moduari egokitzen zaizkion web, mahaigaineko eta barne-tresna aplikazioak diseinatzen eta garatzen ditugu, ez alderantziz. Ideiatik ekoizpeneko softwarera.",
    ctaHero: "Kontatu iguzu zure proiektua",
    queTitle: "Zer garatzen dugu",
    queSubtitle: "Zure beharraren arabera aukeratzen dugu teknologia, ez alderantziz.",
    que: [
      {
        icon: "fa-desktop",
        title: "Barne-tresnak eta mahaigaineko aplikazioak",
        desc: "Neurrira egindako aplikazioak (adibidez Python-ekin) zure taldeko eskuzko edo errepikakortasun handiko lanak digitalizatzeko.",
      },
      {
        icon: "fa-globe",
        title: "Web aplikazio eta plataformak",
        desc: "PHP/Laravel, Node.js edo Django bidezko garapena: kudeaketa-panelak, bezero-atariak, neurrizko plataformak.",
      },
      {
        icon: "fa-plug",
        title: "Integrazioak eta automatizazioa",
        desc: "Zure software berria zure oraingo tresnekin konektatzen dugu (CRM, ERP, kalkulu-orriak, n8n), informazioa bakarrik ibil dadin.",
      },
      {
        icon: "fa-wrench",
        title: "Mantenimendua eta bilakaera",
        desc: "Ez gara desagertzen entrega ondoren: laguntza ematen dugu eta funtzionalitate berriak garatzen jarraitzen dugu zure negozioa hazten den heinean.",
      },
    ],
    procesoTitle: "Nola lan egiten dugu",
    proceso: [
      {
        titulo: "Diagnostikoa eta irismena",
        contenido:
          "Konpondu nahi duzun benetako prozesua edo arazoa aztertzen dugu, eta irismen argia definitzen dugu, proiektua neurriz kanpo egin gabe.",
      },
      {
        titulo: "Prototipoa eta balidazioa",
        contenido:
          "Sakon programatu aurretik, prototipo funtzional bat balidatzen dugu zurekin, norabide egokian goazela ziurtatzeko.",
      },
      {
        titulo: "Garapen iteratiboa",
        contenido:
          "Aplikazioa entrega gehigarritan eraikitzen dugu, etengabeko komunikazioarekin eta azken orduko ezustekorik gabe.",
      },
      {
        titulo: "Abian jartzea eta laguntza",
        contenido:
          "Aplikazioa martxan jartzen dugu, zure taldea erabileran trebatzen dugu eta ondorengo mantenimendurako eskuragarri gelditzen gara.",
      },
    ],
    ctaTitle: "Ideia bat edo digitalizatu beharreko prozesu bat duzu?",
    ctaBody:
      "Kontatu iguzu zer behar duzun eta, konpromisorik gabe, nola landuko genukeen eta zure kasurako zer teknologia den zentzuzkoa esango dizugu.",
    ctaButton: "Informazioa eskatu",
  },
};

const dict = translations[lang] || translations.es;
const title = `${dict.title} – BideDigitala`;
---

<BaseLayout lang={lang} title={title}>
  <!-- Hero -->
  <section class="service-hero">
    <div class="container">
      <div class="hero-content">
        <h1 class="hero-title">{dict.title}</h1>
        <p class="hero-subtitle">{dict.subtitulo}</p>
        <p class="hero-description">{dict.intro}</p>
        <a href={`${tPath("/", lang)}#contacto`} class="btn btn-primary">
          <i class="fas fa-rocket" aria-hidden="true"></i>
          {dict.ctaHero}
        </a>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Qué desarrollamos -->
  <section class="service-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{dict.queTitle}</h2>
        <p class="section-subtitle">{dict.queSubtitle}</p>
      </div>
      <div class="service-grid">
        {
          dict.que.map((item) => (
            <div class="service-item-card">
              <div class="service-item-icon">
                <i class={`fas ${item.icon}`} aria-hidden="true" />
              </div>
              <h3>{item.title}</h3>
              <p>{item.desc}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Cómo trabajamos -->
  <section class="service-section proceso-section">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">{dict.procesoTitle}</h2>
      </div>
      <div class="proceso-steps">
        {
          dict.proceso.map((paso, i) => (
            <div class="proceso-step">
              <div class="proceso-number">{i + 1}</div>
              <div>
                <h3>{paso.titulo}</h3>
                <p>{paso.contenido}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="service-cta">
    <div class="container">
      <h2>{dict.ctaTitle}</h2>
      <p>{dict.ctaBody}</p>
      <a href={`${tPath("/", lang)}#contacto`} class="btn btn-primary">
        <i class="fas fa-paper-plane" aria-hidden="true"></i>
        {dict.ctaButton}
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .service-hero {
    padding: 130px 0 3rem;
    text-align: center;
    background: linear-gradient(160deg, var(--color-bg-secondary) 0%, var(--color-bg) 60%);
  }

  .service-hero .hero-content {
    max-width: 780px;
    margin: 0 auto;
  }

  .service-hero .hero-title {
    margin-bottom: 1rem;
    color: var(--color-text-primary);
  }

  .service-hero .hero-subtitle {
    margin-bottom: 0.75rem;
    color: var(--color-purple);
    font-weight: 600;
    font-size: 1.25rem;
  }

  .service-hero .hero-description {
    max-width: 640px;
    margin: 0 auto 2rem;
    color: var(--color-text-secondary);
    font-size: 1.1rem;
    line-height: 1.6;
  }

  .service-section {
    padding: var(--section-padding);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.75rem;
    margin-top: 2.5rem;
  }

  .service-item-card {
    padding: 1.75rem;
    border-radius: var(--border-radius);
    background: var(--card-gradient);
    border: 1px solid var(--card-border);
    box-shadow: var(--shadow-md);
  }

  .service-item-icon {
    width: 52px;
    height: 52px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    margin-bottom: 1rem;
    background: linear-gradient(135deg, var(--color-purple), var(--color-blue));
  }

  .service-item-icon i {
    color: #fff;
    font-size: 1.25rem;
  }

  .service-item-card h3 {
    /* Sin esto hereda el h3 global (pensado para el blog, ~39px) y
       palabras largas como "Acompañamiento" no caben en la tarjeta y
       se parten a mitad de palabra. */
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: 0.5rem;
  }

  .service-item-card p {
    color: var(--color-text-secondary);
  }

  .proceso-section {
    background: var(--color-bg-secondary);
  }

  .proceso-steps {
    display: grid;
    gap: 1.5rem;
    max-width: 780px;
    margin: 2.5rem auto 0;
  }

  .proceso-step {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    padding: 1.5rem;
    background: var(--color-bg);
    border: 1px solid var(--card-border);
    border-radius: var(--border-radius);
    box-shadow: var(--shadow-md);
  }

  .proceso-number {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: var(--color-purple);
    color: #fff;
    font-weight: 700;
  }

  .proceso-step h3 {
    font-size: 1.25rem;
    line-height: 1.3;
    color: var(--color-text-primary);
    margin-bottom: 0.4rem;
  }

  .proceso-step p {
    color: var(--color-text-secondary);
  }

  .service-cta {
    padding: var(--section-padding);
    text-align: center;
  }

  .service-cta h2 {
    color: var(--color-text-primary);
    margin-bottom: 0.75rem;
  }

  .service-cta p {
    max-width: 620px;
    margin: 0 auto 2rem;
    color: var(--color-text-secondary);
  }
</style>
