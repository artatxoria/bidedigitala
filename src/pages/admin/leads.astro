---
// src/pages/admin/leads.astro
// Panel interno de leads para el equipo comercial: listado, filtros y cambio
// de estado. Usa AdminLayout (shell + pestañas), compartido con /admin/visitas.
export const prerender = false;

import AdminLayout from "../../layouts/AdminLayout.astro";
import { pool, isDbConfigured } from "../../lib/db";
import { SERVICIO_VALUES, SERVICIO_LABELS_ES, PRESUPUESTO_LABELS_ES } from "../../lib/leadOptions";

const ESTADOS = ["nuevo", "contactado", "cualificado", "ganado", "descartado"] as const;
type Estado = (typeof ESTADOS)[number];
const ESTADO_LABELS: Record<Estado, string> = {
  nuevo: "Nuevo",
  contactado: "Contactado",
  cualificado: "Cualificado",
  ganado: "Ganado",
  descartado: "Descartado",
};

interface LeadRow {
  lead_id: string;
  nombre: string;
  empresa: string;
  email: string;
  telefono: string;
  sitio_web: string | null;
  servicio: string;
  presupuesto: string;
  tamano: string | null;
  mensaje: string | null;
  score: number | null;
  priority: string | null;
  resumen_ia: string | null;
  estado: Estado;
  created_at: string;
}

const url = Astro.url;

// ---- POST: cambiar el estado de un lead, luego Post/Redirect/Get ----
if (Astro.request.method === "POST" && isDbConfigured()) {
  const form = await Astro.request.formData();
  const leadId = String(form.get("leadId") || "");
  const nuevoEstado = String(form.get("estado") || "");
  if (leadId && (ESTADOS as readonly string[]).includes(nuevoEstado)) {
    try {
      await pool!.query(`UPDATE leads SET estado = $1, updated_at = now() WHERE lead_id = $2`, [
        nuevoEstado,
        leadId,
      ]);
    } catch (e) {
      console.error("[admin/leads] update estado error:", e);
    }
  }
  return Astro.redirect(url.pathname + url.search, 303);
}

// ---- GET: listado filtrado ----
const filtroEstado = url.searchParams.get("estado") || "";
const filtroPrioridad = url.searchParams.get("prioridad") || "";
const filtroServicio = url.searchParams.get("servicio") || "";

let leads: LeadRow[] = [];
let dbError: string | null = null;

if (isDbConfigured()) {
  try {
    const conditions: string[] = [];
    const params: unknown[] = [];
    if (filtroEstado) {
      params.push(filtroEstado);
      conditions.push(`estado = $${params.length}`);
    }
    if (filtroPrioridad) {
      params.push(filtroPrioridad);
      conditions.push(`priority = $${params.length}`);
    }
    if (filtroServicio) {
      params.push(filtroServicio);
      conditions.push(`servicio = $${params.length}`);
    }
    const where = conditions.length ? `WHERE ${conditions.join(" AND ")}` : "";
    const { rows } = await pool!.query<LeadRow>(
      `SELECT lead_id, nombre, empresa, email, telefono, sitio_web, servicio, presupuesto,
              tamano, mensaje, score, priority, resumen_ia, estado, created_at
         FROM leads
         ${where}
         ORDER BY CASE priority WHEN 'alta' THEN 0 WHEN 'media' THEN 1 WHEN 'baja' THEN 2 ELSE 3 END,
                  created_at DESC
         LIMIT 200`,
      params
    );
    leads = rows;
  } catch (e) {
    dbError = e instanceof Error ? e.message : String(e);
    console.error("[admin/leads] query error:", e);
  }
} else {
  dbError = "PostgreSQL no configurado (faltan POSTGRES_HOST/USER/PASSWORD/DB).";
}

/** Solo renderiza como enlace clicable si es un http(s) válido — evita esquemas tipo javascript: en el href. */
function safeHref(raw: string | null): string | null {
  if (!raw) return null;
  try {
    const candidate = /^https?:\/\//i.test(raw) ? raw : `https://${raw}`;
    const u = new URL(candidate);
    return u.protocol === "http:" || u.protocol === "https:" ? u.toString() : null;
  } catch {
    return null;
  }
}

function fmtFecha(iso: string): string {
  return new Date(iso).toLocaleString("es-ES", { dateStyle: "short", timeStyle: "short" });
}
---

<AdminLayout title="Leads" active="leads">
  <style>
    .score { font-weight: 700; }
  </style>

  <form class="filters" method="GET">
    <label>
      Estado
      <select name="estado">
        <option value="">Todos</option>
        {ESTADOS.map((e) => (
          <option value={e} selected={filtroEstado === e}>{ESTADO_LABELS[e]}</option>
        ))}
      </select>
    </label>
    <label>
      Prioridad
      <select name="prioridad">
        <option value="">Todas</option>
        {["alta", "media", "baja"].map((p) => (
          <option value={p} selected={filtroPrioridad === p}>{p}</option>
        ))}
      </select>
    </label>
    <label>
      Servicio
      <select name="servicio">
        <option value="">Todos</option>
        {SERVICIO_VALUES.map((s: string) => (
          <option value={s} selected={filtroServicio === s}>
            {SERVICIO_LABELS_ES[s as keyof typeof SERVICIO_LABELS_ES]}
          </option>
        ))}
      </select>
    </label>
    <button type="submit" class="primary">Filtrar</button>
    {(filtroEstado || filtroPrioridad || filtroServicio) && (
      <a class="clear" href={url.pathname}>Quitar filtros</a>
    )}
  </form>

  {dbError ? (
    <div class="error">⚠️ {dbError}</div>
  ) : leads.length === 0 ? (
    <div class="empty">No hay leads que coincidan con estos filtros.</div>
  ) : (
    <>
      <div class="count">{leads.length} lead{leads.length === 1 ? "" : "s"}</div>
      <table>
        <thead>
          <tr>
            <th>Fecha</th>
            <th>Contacto</th>
            <th>Servicio</th>
            <th>Presupuesto</th>
            <th>Tamaño</th>
            <th>Score</th>
            <th>Resumen IA</th>
            <th>Mensaje</th>
            <th>Estado</th>
          </tr>
        </thead>
        <tbody>
          {leads.map((lead) => {
            const href = safeHref(lead.sitio_web);
            return (
              <tr>
                <td>{fmtFecha(lead.created_at)}</td>
                <td>
                  <strong>{lead.nombre}</strong><br />
                  {lead.empresa}<br />
                  <a href={`mailto:${lead.email}`}>{lead.email}</a><br />
                  {lead.telefono}
                  {href && (
                    <>
                      <br /><a href={href} target="_blank" rel="noopener noreferrer">{lead.sitio_web}</a>
                    </>
                  )}
                </td>
                <td>{SERVICIO_LABELS_ES[lead.servicio as keyof typeof SERVICIO_LABELS_ES] || lead.servicio}</td>
                <td>{PRESUPUESTO_LABELS_ES[lead.presupuesto as keyof typeof PRESUPUESTO_LABELS_ES] || lead.presupuesto}</td>
                <td>{lead.tamano || "—"}</td>
                <td>
                  {lead.score !== null ? (
                    <span class={`score prio-${lead.priority}`}>{lead.score} · {lead.priority}</span>
                  ) : (
                    <span class="prio-baja">pendiente</span>
                  )}
                </td>
                <td class="wrap-text">{lead.resumen_ia || "—"}</td>
                <td class="wrap-text">{lead.mensaje || "—"}</td>
                <td>
                  <form method="POST">
                    <input type="hidden" name="leadId" value={lead.lead_id} />
                    <select name="estado" onchange="this.form.submit()">
                      {ESTADOS.map((e) => (
                        <option value={e} selected={lead.estado === e}>{ESTADO_LABELS[e]}</option>
                      ))}
                    </select>
                  </form>
                </td>
              </tr>
            );
          })}
        </tbody>
      </table>
    </>
  )}
</AdminLayout>
