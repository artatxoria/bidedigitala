# Copia este archivo a .env y rellena los valores reales (nunca commitear .env).

# ── SMTP (envío de emails del formulario de contacto) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ── Persistencia local de leads (JSONL, auditoría/fallback) ────────────────
DATA_DIR=./data
LEADS_FILE=leads.jsonl

# ── Airtable (base de datos principal de leads para el equipo de ventas) ───
# Personal Access Token con scopes data.records:read + data.records:write
# sobre la base concreta (airtable.com/create/tokens).
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Leads

# ── Gemini (Google GenAI) — scoring automático de leads ────────────────────
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_MS=15000

# ── Scraping de la web del prospecto (opcional, tiene defaults en código) ──
SCRAPE_TIMEOUT_MS=6000
