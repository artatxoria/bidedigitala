# Copia este archivo a .env y rellena los valores reales (nunca commitear .env).

# ── SMTP (envío de emails del formulario de contacto) ──────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TO=

# ── Persistencia local de leads (JSONL, auditoría/fallback) ────────────────
DATA_DIR=./data
LEADS_FILE=leads.jsonl

# ── PostgreSQL (base de datos principal de leads) ───────────────────────────
# Base de datos DEDICADA (recomendado: bidedigitala_leads), no compartida con
# otras apps. Aplica db/schema.sql una vez contra esa base antes del primer
# arranque.
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
POSTGRES_SSL=false

# ── Panel de administración de leads (/admin/leads) ─────────────────────────
# Basic Auth simple: usuario/contraseña compartidos por el equipo comercial.
ADMIN_USER=
ADMIN_PASSWORD=

# ── Gemini (Google GenAI) — scoring automático de leads ────────────────────
GEMINI_API_KEY=
# "gemini-flash-latest" es un alias que Google mantiene apuntando al modelo
# Flash vigente — evita fijar una versión concreta que Google puede
# descontinuar para API keys nuevas. Fija una versión estable aquí (p.ej.
# gemini-3.6-flash) solo si prefieres controlar tú los cambios de modelo.
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=15000

# ── Scraping de la web del prospecto (opcional, tiene defaults en código) ──
SCRAPE_TIMEOUT_MS=6000
